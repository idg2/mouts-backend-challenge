<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ambev.DeveloperEvaluation.Domain\Ambev.DeveloperEvaluation.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />    
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="OneOf" Version="3.0.271" />
  </ItemGroup>

  <!-- Work item: TD-008. GHSA-rvv3-g6hj-g44x: AutoMapper before 15.1.1 has no depth limit, so mapping a deeply nested
       object graph can overflow the stack. No mapped type here references itself (request, command, result, and
       response DTOs are flat or one level of items), so the input cannot nest. Upgrading means AutoMapper 15+, which
       needs a license key. Remove this suppression when the package is upgraded. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>

</Project>
